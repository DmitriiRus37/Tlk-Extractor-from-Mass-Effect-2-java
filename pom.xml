<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/maven-v4_0_0.xsd">

    <modelVersion>4.0.0</modelVersion>
    <groupId>ru</groupId>
    <artifactId>tlk-extractor</artifactId>
    <version>1.0-SNAPSHOT</version>

    <properties>
        <!-- The bytecode/API level is Java 8 on every JDK: "release" 8 on JDK 9+ and source/target
             1.8 on JDK 8, whose javac has no release option (see the release-8 profile). -->
        <maven.compiler.source>1.8</maven.compiler.source>
        <maven.compiler.target>1.8</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <main.class>ru.App</main.class>

        <!-- dependencies -->
        <lombok.version>1.18.48</lombok.version>
        <!-- OpenJFX for JDK 25+; older JDKs get an older line from the openjfx-* profiles below -->
        <javafx.version>27</javafx.version>
        <commons-io.version>2.22.0</commons-io.version>

        <!-- test dependencies (JUnit 5.x, not 6.x: JUnit 6 requires Java 17) -->
        <junit-jupiter.version>5.14.4</junit-jupiter.version>

        <!-- plugins -->
        <maven-clean-plugin.version>3.5.0</maven-clean-plugin.version>
        <maven-resources-plugin.version>3.5.0</maven-resources-plugin.version>
        <maven-compiler-plugin.version>3.16.0</maven-compiler-plugin.version>
        <maven-surefire-plugin.version>3.6.0</maven-surefire-plugin.version>
        <maven-jar-plugin.version>3.5.1</maven-jar-plugin.version>
        <maven-install-plugin.version>3.2.0</maven-install-plugin.version>
        <maven-deploy-plugin.version>3.2.0</maven-deploy-plugin.version>
        <maven-site-plugin.version>3.22.0</maven-site-plugin.version>
        <maven-javadoc-plugin.version>3.12.0</maven-javadoc-plugin.version>
        <javafx-maven-plugin.version>0.0.8</javafx-maven-plugin.version>
        <exec-maven-plugin.version>3.6.4</exec-maven-plugin.version>
        <versions-maven-plugin.version>2.22.0</versions-maven-plugin.version>
        <jacoco-maven-plugin.version>0.8.15</jacoco-maven-plugin.version>

        <!-- minimum coverage enforced by "mvn verify" (jacoco:check) for the non-GUI code -->
        <jacoco.minimum.line.coverage>0.90</jacoco.minimum.line.coverage>
        <jacoco.minimum.branch.coverage>0.85</jacoco.minimum.branch.coverage>
        <!-- JVM options of the test JVM; jacoco:prepare-agent prepends its agent (empty if skipped) -->
        <argLine/>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>${junit-jupiter.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>${lombok.version}</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>commons-io</groupId>
            <artifactId>commons-io</artifactId>
            <version>${commons-io.version}</version>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-clean-plugin</artifactId>
                    <version>${maven-clean-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-resources-plugin</artifactId>
                    <version>${maven-resources-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${maven-compiler-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${maven-surefire-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>${maven-jar-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-install-plugin</artifactId>
                    <version>${maven-install-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-deploy-plugin</artifactId>
                    <version>${maven-deploy-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-site-plugin</artifactId>
                    <version>${maven-site-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.jacoco</groupId>
                    <artifactId>jacoco-maven-plugin</artifactId>
                    <version>${jacoco-maven-plugin.version}</version>
                </plugin>
                <plugin>
                    <!-- "mvn compile exec:java" runs the GUI on a JDK 8 that bundles JavaFX -->
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>exec-maven-plugin</artifactId>
                    <version>${exec-maven-plugin.version}</version>
                    <configuration>
                        <mainClass>${main.class}</mainClass>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-javadoc-plugin</artifactId>
                    <version>${maven-javadoc-plugin.version}</version>
                    <configuration>
                        <!-- this is an application, not a library: document (and doclint-check) every member -->
                        <show>private</show>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <compilerArgs>
                        <!-- JDK 21+ warns that release/source 8 is obsolete; it is still supported -->
                        <arg>-Xlint:-options</arg>
                    </compilerArgs>
                    <!-- JDK 23+ no longer runs annotation processors found on the classpath implicitly -->
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- no file.encoding pin: the code and the tests use explicit charsets, and
                         TlkFileTest checks the export under a non-UTF-8 default charset -->
                    <argLine>@{argLine}</argLine>
                </configuration>
            </plugin>

            <!-- code coverage: "mvn verify" writes target/site/jacoco and enforces the minimums -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <!-- sets ${argLine}, which surefire passes to the forked test JVM -->
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                        <configuration>
                            <!-- only instrument this project (not JavaFX, JUnit, ...) -->
                            <includes>
                                <include>ru.*</include>
                            </includes>
                        </configuration>
                    </execution>
                    <execution>
                        <!-- report over the whole code base, GUI included -->
                        <id>report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <!-- The GUI classes are left out of the threshold: their tests need a JavaFX
                                 toolkit and are skipped where none can start (no display and no headless
                                 Glass platform, which only JavaFX 25+ has), and the file-chooser handlers
                                 cannot be exercised headlessly at all. They still appear in the report. -->
                            <excludes>
                                <exclude>ru/App.class</exclude>
                                <exclude>ru/App$*.class</exclude>
                                <exclude>ru/FxmlController.class</exclude>
                                <exclude>ru/FxmlController$*.class</exclude>
                            </excludes>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${jacoco.minimum.line.coverage}</minimum>
                                        </limit>
                                        <limit>
                                            <counter>BRANCH</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${jacoco.minimum.branch.coverage}</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>versions-maven-plugin</artifactId>
                <version>${versions-maven-plugin.version}</version>
                <configuration>
                    <!-- only suggest stable releases (skip -ea, -alpha, -beta, -rc, -M builds) -->
                    <ruleSet>
                        <ignoreVersions>
                            <ignoreVersion>
                                <type>regex</type>
                                <version>(?i).*[-.](ea|alpha|beta|rc|cr|m)[-+.]?\d*.*</version>
                            </ignoreVersion>
                        </ignoreVersions>
                    </ruleSet>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <!--
      Java 8 to 25 from one pom: the profiles below are activated by the JDK that runs Maven.

      | JDK running Maven | bytecode          | JavaFX for the GUI                                  |
      |===================|===================|=====================================================|
      | 8                 | source/target 1.8 | the JDK's own jre/lib/ext/jfxrt.jar (Zulu FX,       |
      |                   |                   | Liberica Full, Oracle 8); without one the GUI       |
      |                   |                   | classes and tests are left out (no-javafx)          |
      | 9, 10             | release 8         | none, GUI left out (no-javafx)                      |
      | [11,17)           | release 8         | OpenJFX 17.0.x (its class files need Java 11)       |
      | [17,23)           | release 8         | OpenJFX 21.0.x (needs Java 17)                      |
      | [23,25)           | release 8         | OpenJFX 25.0.x (needs Java 23)                      |
      | 25+               | release 8         | OpenJFX 27 (needs Java 25)                          |

      OpenJFX is only published to Maven Central for JDK 11+, and every line needs a minimum JDK
      (the class file version of its jars). Each JDK range gets the latest release of the newest
      long-term-support line (17, 21, 25) it can run; JDK 25+ gets the current release.
    -->
    <profiles>
        <!-- JDK 9+: compile for Java 8, API checked against the Java 8 class library -->
        <profile>
            <id>release-8</id>
            <activation>
                <jdk>[9,)</jdk>
            </activation>
            <properties>
                <maven.compiler.release>8</maven.compiler.release>
            </properties>
        </profile>

        <!--
          JDK 8 (also 9 and 10) without a bundled JavaFX, e.g. Amazon Corretto 8 or Temurin 8:
          OpenJFX from Maven Central needs Java 11+, so the JavaFX GUI (App, FxmlController) and
          its tests are not built; the TLK conversion classes and their tests are. On JDK 8 the
          bundled JavaFX is jre/lib/ext/jfxrt.jar (java.home is the jre directory), which javac
          and the test JVM pick up from the extension directory without any configuration.
        -->
        <profile>
            <id>no-javafx</id>
            <activation>
                <jdk>[1.8,11)</jdk>
                <file>
                    <missing>${java.home}/lib/ext/jfxrt.jar</missing>
                </file>
            </activation>
            <properties>
                <javadoc.no-javafx.sources>${project.build.directory}/javadoc-sources</javadoc.no-javafx.sources>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-compiler-plugin</artifactId>
                        <configuration>
                            <excludes>
                                <exclude>ru/App.java</exclude>
                                <exclude>ru/FxmlController.java</exclude>
                            </excludes>
                            <testExcludes>
                                <testExclude>ru/AppTest.java</testExclude>
                                <testExclude>ru/FxmlControllerTest.java</testExclude>
                                <testExclude>ru/JavaFxToolkit.java</testExclude>
                            </testExcludes>
                        </configuration>
                    </plugin>
                    <!-- JDK 8's javadoc parses every source file of a package it finds on the source
                         path, so excluding the GUI files is not enough: document a copy without them -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-resources-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>javadoc-sources-without-javafx</id>
                                <phase>generate-sources</phase>
                                <goals>
                                    <goal>copy-resources</goal>
                                </goals>
                                <configuration>
                                    <outputDirectory>${javadoc.no-javafx.sources}</outputDirectory>
                                    <resources>
                                        <resource>
                                            <directory>${project.build.sourceDirectory}</directory>
                                            <excludes>
                                                <exclude>ru/App.java</exclude>
                                                <exclude>ru/FxmlController.java</exclude>
                                            </excludes>
                                        </resource>
                                    </resources>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <configuration>
                            <sourcepath>${javadoc.no-javafx.sources}</sourcepath>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- JDK 11+: JavaFX from Maven Central, in the version chosen by the openjfx-* profiles -->
        <profile>
            <id>openjfx</id>
            <activation>
                <jdk>[11,)</jdk>
            </activation>
            <dependencies>
                <!-- JavaFX modules used directly by the code / app.fxml -->
                <dependency>
                    <groupId>org.openjfx</groupId>
                    <artifactId>javafx-graphics</artifactId>
                    <version>${javafx.version}</version>
                </dependency>
                <dependency>
                    <groupId>org.openjfx</groupId>
                    <artifactId>javafx-controls</artifactId>
                    <version>${javafx.version}</version>
                </dependency>
                <dependency>
                    <groupId>org.openjfx</groupId>
                    <artifactId>javafx-fxml</artifactId>
                    <version>${javafx.version}</version>
                </dependency>
            </dependencies>
            <build>
                <plugins>
                    <!-- "mvn javafx:run" launches the GUI with JavaFX on the module path -->
                    <plugin>
                        <groupId>org.openjfx</groupId>
                        <artifactId>javafx-maven-plugin</artifactId>
                        <version>${javafx-maven-plugin.version}</version>
                        <configuration>
                            <mainClass>${main.class}</mainClass>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>openjfx-17</id>
            <activation>
                <jdk>[11,17)</jdk>
            </activation>
            <properties>
                <javafx.version>17.0.20</javafx.version>
            </properties>
        </profile>
        <profile>
            <id>openjfx-21</id>
            <activation>
                <jdk>[17,23)</jdk>
            </activation>
            <properties>
                <javafx.version>21.0.12</javafx.version>
            </properties>
        </profile>
        <profile>
            <id>openjfx-25</id>
            <activation>
                <jdk>[23,25)</jdk>
            </activation>
            <properties>
                <javafx.version>25.0.4</javafx.version>
            </properties>
        </profile>
        <!-- JDK 25+ uses the default javafx.version (27) -->

        <!-- JDK 24+ (JEP 472) warns when javafx.graphics loads its native libraries otherwise;
             older JDKs (11 to 16) do not even know the option -->
        <profile>
            <id>javafx-native-access</id>
            <activation>
                <jdk>[24,)</jdk>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.openjfx</groupId>
                        <artifactId>javafx-maven-plugin</artifactId>
                        <configuration>
                            <options>
                                <option>--enable-native-access=javafx.graphics</option>
                            </options>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
